#!/bin/sh /etc/rc.common
# StreamWatch gateway service (OpenWrt procd).
#
# Keeps streamwatch_v12.py running ALWAYS: starts on boot, and respawns it if
# it ever exits. Install on the gateway node (main123):
#
#   cp streamwatch.init /etc/init.d/streamwatch && chmod +x /etc/init.d/streamwatch
#   /etc/init.d/streamwatch enable        # start on every boot
#   /etc/init.d/streamwatch start
#   logread -f | grep streamwatch         # watch it
#
# Options live in /etc/streamwatch/streamwatch.conf (sourced below), so you can
# change the email, threshold or flags without touching this script. After an
# option change:  /etc/init.d/streamwatch restart
#
# NOTE on the gate: stopping the service does NOT tear down the SW_GATE
# default-deny rules (a security default must not undo itself, and the gate
# self-heals after a firewall reload while the service runs). To open the LAN
# again deliberately:  /etc/init.d/streamwatch gate_down

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
SCRIPT=/root/streamwatch_v12.py
CONF=/etc/streamwatch/streamwatch.conf

extra_command "gate_down" "Remove the SW_GATE default-deny chain (opens the LAN)"

start_service() {
	# Defaults -- override any of these in $CONF.
	SW_EMAIL_TO="manaratcyber@gmail.com"
	SW_THRESHOLD="500M"
	SW_EXTRA="--accept-commands --group-lists"
	[ -f "$CONF" ] && . "$CONF"

	procd_open_instance streamwatch
	procd_set_param command "$PROG" "$SCRIPT" \
		--email-alert --email-to "$SW_EMAIL_TO" \
		--threshold "$SW_THRESHOLD" $SW_EXTRA
	# respawn: within a 3600s window, wait 5s between restarts, retry forever (0).
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/streamwatch.pid
	procd_close_instance
}

gate_down() {
	for i in $(iptables -S FORWARD 2>/dev/null | sed -n 's/.*-i \([^ ]*\) -j SW_GATE/\1/p'); do
		while iptables -D FORWARD -i "$i" -j SW_GATE 2>/dev/null; do :; done
	done
	iptables -F SW_GATE 2>/dev/null
	iptables -X SW_GATE 2>/dev/null
	echo "SW_GATE removed -- the LAN is open again (deny-list MAC blocks, if any, remain)."
}
