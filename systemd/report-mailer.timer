[Unit]
Description=Run the StreamWatch report mailer on a schedule

[Timer]
# Every 5 minutes, every run (~288 emails/day; free Gmail caps sending near
# 500/day). For less: *:0/15 or hourly. minutely (~1440/day) gets suspended.
OnCalendar=*:0/5
Persistent=false
AccuracySec=15s

[Install]
WantedBy=timers.target
