[Unit]
Description=StreamWatch per-device report -> email (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# adjust User and paths to match your install
User=bravofox
WorkingDirectory=/home/bravofox/theSaud
# Emails every run. Add to email only when the model flags a device.
ExecStart=/usr/bin/python3 /home/bravofox/theSaud/report_mailer.py --dir /home/bravofox/mesh_records --env /home/bravofox/.streamwatch_env
